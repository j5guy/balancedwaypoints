<%- include('../components/head', { title: title }) %>
<%- include('../components/nav') %>
<main class="page page-reports">
    <div class="page-header">
        <h1>Reports</h1>
    </div>
    <div id="reports-error" class="form-error" hidden></div>

    <div class="month-nav">
        <button type="button" class="btn btn-secondary btn-sm" id="prev-month-btn">&larr;</button>
        <div class="month-label" id="report-month-label"></div>
        <button type="button" class="btn btn-secondary btn-sm" id="next-month-btn">&rarr;</button>
    </div>

    <div class="form-row">
        <div class="form-group">
            <label for="report-from">From</label>
            <input type="date" id="report-from">
        </div>
        <div class="form-group">
            <label for="report-to">To</label>
            <input type="date" id="report-to">
        </div>
        <div class="form-group" style="align-self:flex-end;">
            <button type="button" class="btn btn-primary" id="run-report-btn">Use this range</button>
        </div>
    </div>
    <p class="form-hint">Pick a custom range above, or use the month arrows — both run the same report.</p>

    <div class="card">
        <h3>Spending by category</h3>
        <div class="diverging-legend" id="spending-legend" hidden>
            <span class="legend-spent"><span class="legend-swatch"></span>Spent</span>
            <span class="legend-remaining"><span class="legend-swatch"></span>Remaining budget</span>
            <span class="legend-over-budget"><span class="legend-swatch"></span>Over budget</span>
        </div>
        <div id="spending-chart" class="spend-chart"></div>
    </div>

    <div class="card">
        <h3>Income vs. expense</h3>
        <div class="diverging-legend">
            <span class="legend-income"><span class="legend-swatch"></span>Income</span>
            <span class="legend-expense"><span class="legend-swatch"></span>Expense</span>
            <span class="legend-net"><span class="legend-swatch"></span>Net</span>
        </div>
        <div id="income-expense-chart" class="ie-chart"></div>
        <div class="table-wrap" style="margin-top:16px;">
            <table class="data-table">
                <thead><tr><th>Month</th><th>Income</th><th>Expense</th><th>Net</th></tr></thead>
                <tbody id="income-expense-tbody"></tbody>
            </table>
        </div>
    </div>

    <div class="card">
        <h3>Net worth (last 12 months)</h3>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Month</th><th>Net worth</th></tr></thead>
                <tbody id="net-worth-tbody"></tbody>
            </table>
        </div>
    </div>
</main>
<%- include('../components/footer', { pageScripts: ['/js/chartHover.js', '/js/reports.js'] }) %>
