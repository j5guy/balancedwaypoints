<%- include('../components/head', { title: title }) %>
<%- include('../components/nav') %>
<main class="page page-register" data-account-id="<%= accountId %>">
    <div class="page-header">
        <h1 id="account-name">Register</h1>
        <div style="display:flex;align-items:center;gap:12px;">
            <div class="stat-card" style="padding:10px 18px;">
                <div class="stat-label" id="account-balance-label">Balance</div>
                <div class="stat-value money" id="account-balance">—</div>
            </div>
            <button type="button" class="btn btn-secondary btn-sm" id="sync-now-btn" title="Pull new transactions from the bank now" hidden>🔄 Sync Now</button>
            <a href="/imports?account=<%= accountId %>" class="btn btn-secondary btn-sm" id="import-link" title="Import transactions into this account">⇩ Import</a>
            <a href="/accounts?edit=<%= accountId %>" class="btn btn-secondary btn-sm" id="account-settings-link" title="Edit this account's settings">✎ Account settings</a>
            <button type="button" class="btn btn-secondary btn-sm" id="toggle-mask-btn" title="Hide amounts/balances">🙈 Mask</button>
            <button type="button" class="btn btn-secondary btn-sm" id="toggle-settings-btn" title="Table settings">⚙ Table settings</button>
        </div>
    </div>
    <div id="register-error" class="form-error" hidden></div>

    <div class="card" id="asset-instructions-card" hidden>
        <p class="muted">
            This account tracks an estimated value rather than real transactions. When you have a fresh
            estimate, add an entry below with the new value itself (not a change) and an optional note —
            that becomes your value history. Check <a id="asset-instructions-link" href="#" target="_blank" rel="noopener noreferrer"></a>
            for a current estimate. <span id="asset-instructions-caveat"></span>
        </p>
    </div>

    <div class="card" id="register-forecast-card">
        <div class="register-forecast-header">
            <h3>Forecast</h3>
            <button type="button" class="btn btn-secondary btn-sm" id="toggle-forecast-btn">Hide</button>
        </div>
        <div id="register-forecast-chart"></div>
    </div>

    <div class="card" id="mask-panel" hidden>
        <h3>Mask sensitive values</h3>
        <p class="form-hint">Replaces amounts with a fixed placeholder — it never reveals how many digits the real
        number has, so someone glancing at your screen can't even guess the magnitude. Saved to your account, applies
        everywhere you view this (or any) register.</p>
        <div class="checkbox-row form-group">
            <input type="checkbox" id="mask-amount">
            <label for="mask-amount">Mask the Amount column</label>
        </div>
        <div class="checkbox-row form-group">
            <input type="checkbox" id="mask-balance">
            <label for="mask-balance">Mask the Balance column (and the account balance above)</label>
        </div>
    </div>

    <div class="card" id="settings-panel" hidden>
        <h3>Table settings</h3>
        <p class="form-hint">Saved to your account — applies to every register you view, on any device.</p>
        <div class="form-group">
            <label for="pref-register-sort">Sort by</label>
            <select id="pref-register-sort" style="max-width:240px;">
                <option value="newest">Date, newest first</option>
                <option value="oldest">Date, oldest first</option>
                <option value="manual">Manual (custom order)</option>
            </select>
        </div>
        <div class="form-group">
            <label>Columns to show &amp; order (drag ⠿ to reorder)</label>
            <div class="form-row" id="column-toggle-list"></div>
            <button type="button" class="btn btn-secondary btn-sm" id="reset-columns-btn" style="margin-top:8px;">Reset columns to default</button>
        </div>
        <div id="upcoming-schedule-fields">
            <div class="checkbox-row form-group">
                <input type="checkbox" id="pref-show-upcoming">
                <label for="pref-show-upcoming">Show upcoming scheduled transactions in this register</label>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label for="pref-upcoming-amount">Show upcoming within</label>
                    <input type="number" id="pref-upcoming-amount" min="1" style="max-width:100px;">
                </div>
                <div class="form-group">
                    <label for="pref-upcoming-unit">&nbsp;</label>
                    <select id="pref-upcoming-unit">
                        <option value="days">Day(s)</option>
                        <option value="months">Month(s)</option>
                        <option value="years">Year(s)</option>
                    </select>
                </div>
            </div>
        </div>
        <div class="checkbox-row form-group">
            <input type="checkbox" id="pref-limit-history">
            <label for="pref-limit-history">Limit how far back this register loads transactions</label>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="pref-history-amount">Show history within</label>
                <input type="number" id="pref-history-amount" min="1" style="max-width:100px;">
            </div>
            <div class="form-group">
                <label for="pref-history-unit">&nbsp;</label>
                <select id="pref-history-unit">
                    <option value="days">Day(s)</option>
                    <option value="months">Month(s)</option>
                    <option value="years">Year(s)</option>
                </select>
            </div>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-settings-btn">Save settings</button>
            <button type="button" class="btn btn-secondary" id="cancel-settings-btn">Cancel</button>
        </div>
    </div>

    <p class="muted" style="font-size:0.85rem;">
        Type a new transaction directly into the top row of the table below.
        Need a transfer or a split across categories instead?
        <a href="#" id="toggle-advanced-form-link">Use the full form</a>.
    </p>

    <div class="card" id="txn-form-card" hidden>
        <h3 id="txn-form-title">New transaction</h3>
        <input type="hidden" id="txn-id">
        <div class="form-row">
            <div class="form-group">
                <label for="txn-date">Date</label>
                <input type="date" id="txn-date">
            </div>
            <div class="form-group">
                <label for="txn-payee">Payee</label>
                <input type="text" id="txn-payee" list="payee-options" placeholder="Payee name">
                <datalist id="payee-options"></datalist>
            </div>
            <div class="form-group">
                <label for="txn-amount">Amount</label>
                <input type="number" id="txn-amount" step="0.01" placeholder="-45.00">
                <p class="form-hint">Negative for money out, positive for money in.</p>
            </div>
        </div>

        <div class="checkbox-row form-group">
            <input type="checkbox" id="txn-is-transfer">
            <label for="txn-is-transfer">This is a transfer to another account</label>
        </div>

        <div class="form-row" id="txn-category-group">
            <div class="form-group">
                <label for="txn-category">Category</label>
                <input type="text" id="txn-category" list="category-options" placeholder="Category name">
                <datalist id="category-options"></datalist>
            </div>
            <div class="form-group">
                <label for="txn-category-new-group">Group (for a new category)</label>
                <select id="txn-category-new-group"><option value="">— pick a group —</option></select>
                <p class="form-hint">Only used if "Category" above doesn't match an existing one — it'll be created in this group.</p>
            </div>
        </div>

        <div class="form-group" id="txn-transfer-group" hidden>
            <label for="txn-transfer-account">Transfer to</label>
            <select id="txn-transfer-account"></select>
        </div>

        <div class="form-group">
            <div class="btn-row">
                <button type="button" class="btn btn-secondary btn-sm" id="toggle-splits-btn">Split into categories</button>
                <button type="button" class="btn btn-secondary btn-sm" id="suggest-rules-btn">Suggest from rules</button>
            </div>
        </div>

        <div id="splits-editor" hidden>
            <div id="splits-list"></div>
            <button type="button" class="btn btn-secondary btn-sm" id="add-split-btn">Add split line</button>
            <p class="form-hint">Split amounts must add up to the total amount above.</p>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="txn-tags">Tags</label>
                <input type="text" id="txn-tags" placeholder="comma, separated, tags">
            </div>
            <div class="form-group">
                <label for="txn-notes">Notes</label>
                <input type="text" id="txn-notes">
            </div>
            <div class="form-group checkbox-row" style="align-self:flex-end;">
                <input type="checkbox" id="txn-cleared">
                <label for="txn-cleared">Cleared</label>
            </div>
        </div>

        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-txn-btn">Save transaction</button>
            <button type="button" class="btn btn-secondary" id="cancel-txn-btn" hidden>Cancel edit</button>
            <button type="button" class="btn btn-secondary" id="convert-to-transfer-btn" hidden>Convert to transfer</button>
        </div>

        <div class="form-row" id="convert-to-transfer-form" hidden>
            <div class="form-group">
                <label for="convert-transfer-account">Transfer to</label>
                <select id="convert-transfer-account"></select>
                <p class="form-hint">Deletes this entry and replaces it with a transfer pair — same date/amount/notes, linked to the account you pick here.</p>
            </div>
            <div class="form-group" style="align-self:flex-end;">
                <div class="btn-row">
                    <button type="button" class="btn btn-primary btn-sm" id="convert-to-transfer-confirm-btn">Confirm</button>
                    <button type="button" class="btn btn-secondary btn-sm" id="convert-to-transfer-cancel-btn">Cancel</button>
                </div>
            </div>
        </div>
    </div>

    <p class="muted" id="register-hint" style="font-size:0.85rem;" hidden>Drag a row by its handle (⠿) to reorder the register — the Balance column recalculates from the new order, top to bottom. Dragging switches "Sort by" (Table settings) to Manual, so your arrangement sticks instead of snapping back to date order.</p>

    <div class="card" id="bulk-actions-bar" hidden style="display:flex;align-items:center;gap:12px;padding:10px 16px;">
        <strong id="bulk-selected-count">0 selected</strong>
        <select id="bulk-category-select" style="max-width:220px;">
            <option value="">— choose category —</option>
        </select>
        <button type="button" class="btn btn-primary btn-sm" id="bulk-apply-category-btn">Set category</button>
        <button type="button" class="btn btn-secondary btn-sm" id="bulk-clear-btn">Clear selection</button>
    </div>

    <div class="table-wrap register-table-wrap">
        <table class="data-table register-table">
            <colgroup>
                <col style="width:22px">
                <col style="width:22px">
                <col style="width:92px" data-col="date">
                <col style="width:130px" data-col="payee">
                <col style="width:120px" data-col="category">
                <col data-col="notes">
                <col style="width:100px" data-col="tags">
                <col style="width:88px" data-col="amount">
                <col style="width:88px" data-col="balance">
                <col style="width:34px" data-col="cleared">
                <col style="width:130px">
            </colgroup>
            <thead>
                <tr>
                    <th><input type="checkbox" id="select-all-checkbox" title="Select all"></th>
                    <th></th>
                    <th data-col="date">Date</th>
                    <th data-col="payee">Payee</th>
                    <th data-col="category">Category</th>
                    <th class="wrap" data-col="notes">Notes</th>
                    <th data-col="tags">Tags</th>
                    <th data-col="amount">Amount</th>
                    <th data-col="balance">Balance</th>
                    <th title="Cleared" data-col="cleared">✓</th>
                    <th></th>
                </tr>
            </thead>
            <tbody id="filter-tbody">
                <tr class="filter-row">
                    <td></td>
                    <td class="muted" style="text-align:center;" title="Live filter — matching rows narrow as you type">⌕</td>
                    <td data-col="date"><input type="text" id="filter-date" placeholder="Filter…"></td>
                    <td data-col="payee"><input type="text" id="filter-payee" placeholder="Filter…"></td>
                    <td data-col="category"><input type="text" id="filter-category" placeholder="Filter…"></td>
                    <td class="wrap" data-col="notes"><input type="text" id="filter-notes" placeholder="Filter…"></td>
                    <td data-col="tags"><input type="text" id="filter-tags" placeholder="Filter…"></td>
                    <td data-col="amount"><input type="text" id="filter-amount" placeholder="Filter…"></td>
                    <td class="muted" data-col="balance">—</td>
                    <td data-col="cleared"></td>
                    <td><button type="button" class="btn btn-secondary btn-sm icon-btn" id="filter-clear-btn" title="Clear filters">✕</button></td>
                </tr>
            </tbody>
            <tbody id="quick-add-tbody">
                <tr class="quick-add-row">
                    <td></td>
                    <td class="muted" style="text-align:center;">+</td>
                    <td data-col="date"><input type="date" id="qa-date"></td>
                    <td data-col="payee"><input type="text" id="qa-payee" list="payee-options" placeholder="Payee"></td>
                    <td data-col="category"><input type="text" id="qa-category" list="category-options" placeholder="Category" title="Typing a new name creates it in your first category group — use the full form (⛶) to pick a different group"></td>
                    <td class="wrap" data-col="notes"><input type="text" id="qa-notes" placeholder="Notes"></td>
                    <td data-col="tags"><input type="text" id="qa-tags" placeholder="tag, tag"></td>
                    <td data-col="amount"><input type="number" id="qa-amount" step="0.01" placeholder="-45.00"></td>
                    <td class="muted" data-col="balance">—</td>
                    <td style="text-align:center;" data-col="cleared"><input type="checkbox" id="qa-cleared" title="Cleared" checked></td>
                    <td class="row-actions">
                        <button type="button" class="btn btn-secondary btn-sm icon-btn" id="qa-full-form-btn" title="Open the full form (transfers, splits)">⛶</button>
                        <button type="button" class="btn btn-primary btn-sm" id="qa-add-btn">Add</button>
                    </td>
                </tr>
            </tbody>
            <tbody id="register-tbody"></tbody>
        </table>
    </div>
</main>

<div class="modal-overlay" id="occurrence-overlay" hidden>
    <div class="modal-card" style="max-width:560px;">
        <h3>Upcoming occurrence</h3>
        <p class="muted" id="occ-modal-subtitle"></p>

        <div id="occ-edit-fields">
            <h4 style="margin-bottom:8px;">Edit</h4>
            <div class="form-row">
                <div class="form-group">
                    <label for="occ-amount">Amount</label>
                    <input type="number" id="occ-amount" step="0.01" placeholder="-45.00">
                </div>
                <div class="form-group" id="occ-payee-group">
                    <label for="occ-payee">Payee</label>
                    <input type="text" id="occ-payee" list="payee-options" placeholder="Payee">
                </div>
                <div class="form-group" id="occ-category-group">
                    <label for="occ-category">Category</label>
                    <input type="text" id="occ-category" list="category-options" placeholder="Category">
                </div>
            </div>
            <div class="form-group">
                <label for="occ-notes">Notes</label>
                <input type="text" id="occ-notes" placeholder="Notes">
            </div>
        </div>
        <p class="form-hint" id="occ-edit-splits-note" hidden>
            This schedule uses split categories — edit the schedule itself (from the Schedules page) to change its amounts. You can still delete occurrences below.
        </p>
        <p class="form-hint" id="occ-edit-transfer-note" hidden>
            This schedule transfers to another account — edit the schedule itself (from the Schedules page) to change which account. You can still change the amount/notes for just this occurrence below.
        </p>

        <div class="form-group">
            <label>Applies to</label>
            <div class="checkbox-row" style="width:auto;">
                <input type="radio" name="occ-scope" id="occ-scope-single" value="single">
                <label for="occ-scope-single" style="width:auto;">Just this occurrence</label>
            </div>
            <div class="checkbox-row" style="width:auto;">
                <input type="radio" name="occ-scope" id="occ-scope-count" value="count">
                <label for="occ-scope-count" style="width:auto;">This and the next</label>
            </div>
            <div class="form-row" id="occ-scope-count-row" style="margin-left:24px;max-width:160px;">
                <input type="number" id="occ-scope-count-input" min="1" style="max-width:80px;">
                <span class="muted" style="align-self:center;">occurrences (including this one)</span>
            </div>
            <div class="checkbox-row" style="width:auto;">
                <input type="radio" name="occ-scope" id="occ-scope-forever" value="forever">
                <label for="occ-scope-forever" style="width:auto;">This and every occurrence after</label>
            </div>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="occ-save-edit-btn">Save edit</button>
            <button type="button" class="btn btn-danger" id="occ-delete-occ-btn">Delete occurrence(s)</button>
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:20px 0;">

        <h4 style="margin-bottom:8px;">Post to a real transaction</h4>
        <div class="form-group">
            <div class="checkbox-row" style="width:auto;">
                <input type="radio" name="occ-post-to" id="occ-post-today" value="today">
                <label for="occ-post-today" style="width:auto;">Today</label>
            </div>
            <div class="checkbox-row" style="width:auto;">
                <input type="radio" name="occ-post-to" id="occ-post-scheduled" value="scheduled">
                <label for="occ-post-scheduled" style="width:auto;">Its scheduled date</label>
            </div>
            <div class="checkbox-row" style="width:auto;">
                <input type="radio" name="occ-post-to" id="occ-post-custom" value="custom">
                <label for="occ-post-custom" style="width:auto;">A custom date</label>
            </div>
            <div class="form-group" id="occ-post-custom-row" style="margin-left:24px;max-width:200px;">
                <input type="date" id="occ-post-custom-date">
            </div>
        </div>

        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="occ-post-btn">Post transaction</button>
        </div>

        <hr style="border:none;border-top:1px solid var(--border);margin:20px 0;">

        <div class="btn-row" style="justify-content:space-between;">
            <button type="button" class="btn btn-danger btn-sm" id="occ-delete-schedule-btn">Delete this schedule entirely</button>
            <button type="button" class="btn btn-secondary" id="occ-modal-cancel-btn">Cancel</button>
        </div>
    </div>
</div>

<%- include('../components/footer', { pageScripts: ['/js/dragReorder.js', '/js/chartHover.js', '/js/badgeColor.js', '/js/register.js'] }) %>
