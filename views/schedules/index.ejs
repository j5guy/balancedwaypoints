<%- include('../components/head', { title: title }) %>
<%- include('../components/nav') %>
<main class="page page-schedules">
    <%- include('../components/ownerSwitcher') %>
    <div class="page-header">
        <h1>Schedules</h1>
        <button type="button" class="btn btn-primary" id="new-schedule-btn">Add schedule</button>
    </div>
    <div id="schedules-error" class="form-error" hidden></div>

    <div class="card" id="schedule-form" hidden>
        <h3 id="schedule-form-title">New schedule</h3>
        <div class="form-row">
            <div class="form-group">
                <label for="sched-name">Name</label>
                <input type="text" id="sched-name" placeholder="Rent, Netflix, Paycheck...">
            </div>
            <div class="form-group">
                <label for="sched-account">Account</label>
                <select id="sched-account"></select>
            </div>
            <div class="form-group">
                <label for="sched-amount">Amount</label>
                <input type="number" id="sched-amount" step="0.01" placeholder="-1200.00">
                <p class="form-hint">Negative for money out (rent, bills), positive for money in (paycheck, income).</p>
            </div>
        </div>
        <div class="checkbox-row form-group">
            <input type="checkbox" id="sched-is-transfer">
            <label for="sched-is-transfer">This is a transfer to another account</label>
        </div>
        <div class="checkbox-row form-group">
            <input type="checkbox" id="sched-autopay">
            <label for="sched-autopay">This is autopay (paid automatically by the biller) — shows a badge on posted transactions</label>
        </div>
        <div class="form-group" id="sched-autopay-from-group" hidden>
            <label for="sched-autopay-from-account">Drafted from account (optional)</label>
            <select id="sched-autopay-from-account"><option value="">— same account —</option></select>
            <p class="form-hint">If autopay actually pulls the money from a different account of yours (e.g. a credit card autopaid out of checking), pick it here — posting this schedule will then also record the draft leaving that account, like a transfer.</p>
        </div>
        <div class="form-row" id="sched-category-group">
            <div class="form-group">
                <label for="sched-payee">Payee</label>
                <input type="text" id="sched-payee" list="sched-payee-options" placeholder="Payee name">
                <datalist id="sched-payee-options"></datalist>
            </div>
            <div class="form-group">
                <label for="sched-category">Category</label>
                <select id="sched-category"><option value="">— none —</option></select>
            </div>
        </div>
        <div class="form-row" id="sched-new-category-fields" hidden>
            <div class="form-group">
                <label for="sched-new-category-name">New category name</label>
                <input type="text" id="sched-new-category-name" placeholder="Category name">
            </div>
            <div class="form-group">
                <label for="sched-new-category-group-select">Group</label>
                <select id="sched-new-category-group-select"><option value="">— pick a group —</option></select>
            </div>
        </div>
        <div class="form-group" id="sched-transfer-group" hidden>
            <label for="sched-transfer-account">Transfer to</label>
            <select id="sched-transfer-account"></select>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="sched-next-date">Next date</label>
                <input type="date" id="sched-next-date">
            </div>
            <div class="form-group">
                <label for="sched-end-date">End date (optional)</label>
                <input type="date" id="sched-end-date">
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="sched-interval">Repeat every</label>
                <input type="number" id="sched-interval" value="1" min="1">
            </div>
            <div class="form-group">
                <label for="sched-unit">Unit</label>
                <select id="sched-unit">
                    <option value="days">Day(s)</option>
                    <option value="weeks">Week(s)</option>
                    <option value="months" selected>Month(s)</option>
                    <option value="years">Year(s)</option>
                </select>
            </div>
            <div class="form-group">
                <label for="sched-reminder">Remind days before</label>
                <input type="number" id="sched-reminder" value="3" min="0">
            </div>
        </div>
        <div class="form-group">
            <label for="sched-notes">Notes</label>
            <input type="text" id="sched-notes">
        </div>
        <div class="checkbox-row form-group">
            <input type="checkbox" id="sched-auto-enter">
            <label for="sched-auto-enter">Auto-enter into the register when due (otherwise just a reminder)</label>
        </div>
        <div class="checkbox-row form-group">
            <input type="checkbox" id="sched-notify-email">
            <label for="sched-notify-email">Email everyone with a mail server configured when this is due (see My Account)</label>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-schedule-btn">Save</button>
            <button type="button" class="btn btn-secondary" id="cancel-schedule-btn">Cancel</button>
        </div>
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>Name</th><th>Account</th><th>Payee</th><th>Amount</th><th>Category</th><th>Next date</th><th>Repeats</th><th>Auto-enter</th><th></th></tr></thead>
            <tbody id="schedules-filter-tbody">
                <tr class="filter-row">
                    <td><input type="text" id="sched-filter-name" placeholder="Filter…"></td>
                    <td><input type="text" id="sched-filter-account" placeholder="Filter…"></td>
                    <td><input type="text" id="sched-filter-payee" placeholder="Filter…"></td>
                    <td><input type="text" id="sched-filter-amount" placeholder="Filter…"></td>
                    <td><input type="text" id="sched-filter-category" placeholder="Filter…"></td>
                    <td><input type="text" id="sched-filter-nextdate" placeholder="Filter…"></td>
                    <td><input type="text" id="sched-filter-repeats" placeholder="Filter…"></td>
                    <td></td>
                    <td><button type="button" class="btn btn-secondary btn-sm icon-btn" id="sched-filter-clear-btn" title="Clear filters">✕</button></td>
                </tr>
            </tbody>
            <tbody id="schedules-tbody"></tbody>
        </table>
    </div>
</main>
<%- include('../components/footer', { pageScripts: ['/js/ownerSwitcher.js', '/js/badgeColor.js', '/js/schedules.js'] }) %>
