<%- include('../components/head', { title: title }) %>
<%- include('../components/nav') %>
<main class="page page-auth">
    <div class="auth-card">
        <h1>Sign up</h1>
        <div id="signup-error" class="form-error" hidden></div>
        <form id="signup-form">
            <div class="form-group">
                <label for="displayName">Name</label>
                <input type="text" id="displayName" name="displayName" autocomplete="name">
            </div>
            <div class="form-group">
                <label for="email">Email</label>
                <input type="email" id="email" name="email" required autocomplete="email">
            </div>
            <div class="form-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="password" required minlength="8" autocomplete="new-password">
                <p class="form-hint">At least 8 characters.</p>
            </div>
            <button type="submit" class="btn btn-primary btn-block" id="signup-submit">Create account</button>
        </form>
        <p class="form-hint">
            Already have an account? <a href="/auth/login">Log in</a>
        </p>
    </div>
</main>
<%- include('../components/footer', { pageScripts: ['/js/auth.js'] }) %>
