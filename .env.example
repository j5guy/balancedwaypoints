# Copy this file to .env and fill in the values before running
# `docker compose up -d` — or just run ./install.sh / node scripts/setup-wizard.js
# and let the guided setup do it for you.

# ── Web server ───────────────────────────────────────────────
# The app itself always answers on 5570 inside the container/process — not
# configurable. Reachability over HTTPS comes from the shared Traefik
# reverse proxy every Waypoints app joins (see ../traefik/) — no per-app
# port to pick.

# The domain name (or IP) you'll access this app at.
WEB_FQDN=
# How this app gets its HTTPS certificate: "auto" (default) gets you Let's
# Encrypt when WEB_FQDN looks like a real public domain, and a shared
# self-signed certificate otherwise (LAN/offline installs) — set "acme" or
# "selfsigned" to force one or the other.
TLS_MODE=auto
# A private password the app makes up for itself, used to keep you securely
# logged in and to sign CSRF tokens. Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
sessionSecret=
# Where the app's logs live, backed by the logs-data Docker volume by
# default (survives the container being recreated). To point it at a host
# path instead (e.g. to read logs without `docker exec`, or centralize them
# on a NAS), set a host directory here — same pattern as SSL_CERT_FILE/
# SSL_KEY_FILE below.
LOGS_HOST_DIR=

# ── TLS certificate (host paths) ──────────────────────────────
# Paths on this host to the cert/key that terminate TLS for the bundled
# nginx container. Left blank and the setup wizard generates a self-signed
# one for you at certs/cert.pem / certs/cert.key.
SSL_CERT_FILE=
SSL_KEY_FILE=

# ── Licensing ────────────────────────────────────────────────
# POC: base URL of the central waypoints-licensing service (see ../licensing)
# and the shared secret it expects in the x-license-secret header. Without
# these, every request redirects to /license and stays stuck there — the
# trial/validate calls simply never succeed. If both apps share the
# waypoints-proxy network (the default), this is http://licensing:5590 —
# LICENSE_API_SECRET must match the value set in licensing/.env.
LICENSE_SERVER_URL=
LICENSE_API_SECRET=

# Public key (JWK, single-line JSON) used to verify a hand-issued offline
# license entered on /license — see ../licensing/scripts/createOfflineLicense.js.
# Print this once with ../licensing/scripts/generateOfflineSigningKey.js and
# reuse the same value across every install; it's not a secret. Leave blank
# to simply not support offline activation on this install.
LICENSE_OFFLINE_PUBLIC_KEY_JWK=

# ── Accounts ─────────────────────────────────────────────────
# Email for the initial admin account. The very first person to sign up
# always becomes admin regardless of this setting; set this if you want a
# specific email to always be admin even on a later signup.
ADMIN_EMAIL=

# ── LDAP (optional) ────────────────────────────────────────
# Lets people log in against an external directory (Active Directory,
# OpenLDAP) alongside local accounts — all three of local/LDAP/OIDC are
# always available together, none of them replace another. Leave blank to
# skip entirely; all of this can also be set up later, or changed, from
# Admin > LDAP without a redeploy (settings saved there take priority over
# these values).
LDAP_ENABLED=false
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_SEARCH_BASE=
# Must contain the literal {{username}} placeholder, e.g.
# (sAMAccountName={{username}}) for Active Directory, (uid={{username}}) for OpenLDAP.
LDAP_SEARCH_FILTER=

# ── OIDC / SSO (optional) ──────────────────────────────────
# Generic OpenID Connect — works with any self-hosted identity provider that
# publishes standard discovery (Authentik, Keycloak, Authelia, etc), not a
# specific named provider. Leave blank to skip; can also be set up later, or
# changed, from Admin > OIDC without a redeploy (settings saved there take
# priority over these values). The redirect URI to register with your IdP is
# https://<WEB_FQDN>/auth/oidc/callback.
OIDC_ENABLED=false
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email

# ── Display ──────────────────────────────────────────────────
CURRENCY_SYMBOL=$

# ── MongoDB ──────────────────────────────────────────────────
# Defaults below target the bundled `mongo` container on the compose network
# (internal-only, no auth needed). To use an existing external MongoDB
# instead, point mongoHost at it and set mongoUser/mongoPass.
mongoHost=mongo
mongoUser=
mongoPass=
mongoPort=27017
mongoDBName=balancedwaypoints

# Only used by the bundled internal MongoDB container — overrides its image
# tag. Leave blank unless you know you need an older tag (e.g. very old ARM
# hardware that doesn't support current MongoDB's CPU requirements).
MONGO_IMAGE=
# Only used by the bundled internal MongoDB container (ignored with an
# external one) — backed by the mongo-data Docker volume by default. To
# point it at a host path instead (e.g. a NAS, or a disk with more room),
# set a host directory here — same pattern as SSL_CERT_FILE/SSL_KEY_FILE
# above.
MONGO_HOST_DIR=

# ── Backups ──────────────────────────────────────────────────
# Both site-wide backups (Admin > Backups) and personal backups (My Account
# > Backups) write into /app/backups inside the container by default,
# backed by the "backups-data" Docker volume below. To point that at a host
# directory instead (e.g. a NAS mount) set this to that host path — same
# pattern as SSL_CERT_FILE/SSL_KEY_FILE above. Admins/users can further
# redirect their own backups to any other in-container path from the app's
# UI; that only works if this path (or theirs) is actually mounted here.
BACKUP_HOST_DIR=
