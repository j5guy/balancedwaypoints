<%- include('../components/head', { title: title }) %>
<%- include('../components/nav') %>
<main class="page page-accounts">
    <div class="page-header">
        <h1>Accounts</h1>
        <button type="button" class="btn btn-primary" id="new-account-btn">Add account</button>
    </div>
    <div id="accounts-error" class="form-error" hidden></div>

    <div class="card" id="account-form" hidden>
        <h3 id="account-form-title">New account</h3>
        <input type="hidden" id="acct-id">
        <div class="form-row">
            <div class="form-group">
                <label for="acct-name">Name</label>
                <input type="text" id="acct-name">
            </div>
            <div class="form-group">
                <label for="acct-type">Type</label>
                <select id="acct-type">
                    <option value="checking">Checking</option>
                    <option value="savings">Savings</option>
                    <option value="credit">Credit card</option>
                    <option value="cash">Cash</option>
                    <option value="investment">Investment</option>
                    <option value="loan">Loan</option>
                    <option value="other">Other</option>
                </select>
            </div>
            <div class="form-group">
                <label for="acct-balance">Starting balance</label>
                <input type="number" id="acct-balance" step="0.01" value="0">
                <p class="form-hint" id="acct-balance-hint" hidden>Changing this shifts the account's current balance by the same amount — it doesn't touch any existing transactions.</p>
            </div>
        </div>
        <div class="form-row">
            <div class="checkbox-row form-group">
                <input type="checkbox" id="acct-on-budget" checked>
                <label for="acct-on-budget">On budget (counts toward envelope budgeting)</label>
            </div>
            <div class="checkbox-row form-group" id="acct-closed-group" hidden>
                <input type="checkbox" id="acct-closed">
                <label for="acct-closed">Closed</label>
            </div>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-account-btn">Save</button>
            <button type="button" class="btn btn-secondary" id="cancel-account-btn">Cancel</button>
        </div>
    </div>

    <p class="muted" id="accounts-hint" style="font-size:0.85rem;" hidden>Drag a card by its handle (⠿) to reorder accounts.</p>
    <div class="card-grid" id="accounts-grid"></div>
</main>
<%- include('../components/footer', { pageScripts: ['/js/dragReorder.js', '/js/accounts.js'] }) %>
