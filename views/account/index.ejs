<%- include('../components/head', { title: title }) %>
<%- include('../components/nav') %>
<main class="page page-account">
    <div class="page-header">
        <h1>My Account</h1>
    </div>
    <div id="account-error" class="form-error" hidden></div>
    <div id="account-success" class="form-success" hidden></div>

    <div class="card">
        <h3>Signed in as</h3>
        <p><span id="account-email" class="money"></span> <span class="badge" id="account-auth-source"></span></p>
    </div>

    <div class="card">
        <h3>General</h3>
        <div class="form-group">
            <label for="home-dashboard">When I log in, take me to</label>
            <select id="home-dashboard">
                <option value="dashboard">Dashboard</option>
                <option value="budget">Budget</option>
                <option value="accounts">Accounts</option>
            </select>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-general-btn">Save</button>
        </div>
    </div>

    <div class="card">
        <h3>Email notifications</h3>
        <p class="muted">
            Schedule alerts (turned on per-schedule) and the weekly summary below are sent through
            your own mail server — nothing goes out until you set one up here.
        </p>
        <div class="form-group">
            <label for="notify-email">Send notifications to</label>
            <input type="email" id="notify-email" placeholder="you@example.com">
            <p class="form-hint">Defaults to your login email for a local account. LDAP accounts have no
            guaranteed email from the directory, so set this yourself.</p>
        </div>
        <div class="checkbox-row form-group">
            <input type="checkbox" id="weekly-report-email">
            <label for="weekly-report-email">Email me a weekly summary (spending by category, account balances)</label>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-notifications-btn">Save</button>
        </div>
    </div>

    <div class="card">
        <h3>My outgoing mail server</h3>
        <p class="muted">E.g. Gmail: host <code>smtp.gmail.com</code>, port <code>587</code>, and an
        <a href="https://myaccount.google.com/apppasswords" target="_blank" rel="noopener noreferrer">app password</a>
        (not your regular password) as the password below.</p>
        <div class="form-row">
            <div class="form-group">
                <label for="smtp-host">Host</label>
                <input type="text" id="smtp-host" placeholder="smtp.gmail.com">
            </div>
            <div class="form-group">
                <label for="smtp-port">Port</label>
                <input type="number" id="smtp-port" placeholder="587">
            </div>
            <div class="checkbox-row form-group" style="align-self:flex-end;">
                <input type="checkbox" id="smtp-secure">
                <label for="smtp-secure">Use TLS (usually on for port 465)</label>
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="smtp-user">Username</label>
                <input type="text" id="smtp-user" placeholder="you@gmail.com">
            </div>
            <div class="form-group">
                <label for="smtp-pass">Password</label>
                <input type="password" id="smtp-pass" autocomplete="off">
                <p class="form-hint" id="smtp-pass-hint" hidden>Leave blank to keep the currently saved password.</p>
            </div>
            <div class="form-group">
                <label for="smtp-from">From address (optional)</label>
                <input type="text" id="smtp-from" placeholder="you@gmail.com">
            </div>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-smtp-btn">Save</button>
            <button type="button" class="btn btn-secondary" id="test-smtp-btn">Test connection</button>
            <button type="button" class="btn btn-danger" id="clear-smtp-btn">Clear</button>
        </div>
        <p class="muted" id="smtp-test-status" style="margin-top:12px;"></p>
    </div>

    <div class="card">
        <h3>API access</h3>
        <p class="muted">Read-only access to your report data (<code>/api/reports/*</code>) for tools like
        Grafana. Send it as an HTTP header: <code>Authorization: Bearer &lt;key&gt;</code>.</p>
        <p id="api-key-status" class="muted"></p>
        <div id="api-key-reveal" class="form-group" hidden>
            <label for="api-key-value">Your new key (shown once — copy it now)</label>
            <input type="text" id="api-key-value" readonly onclick="this.select()">
            <p class="form-hint">This won't be shown again. Generating a new key immediately invalidates this one.</p>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="generate-api-key-btn">Generate new key</button>
            <button type="button" class="btn btn-danger" id="revoke-api-key-btn">Revoke</button>
        </div>
    </div>

    <div class="card">
        <h3>Appearance</h3>
        <p class="muted">Override any color the app uses, independently for light and dark theme. Leave a
        field at its default (or hit "Reset this theme") to keep following the app's normal palette there.</p>
        <div class="form-row">
            <div class="form-group appearance-theme-col">
                <h4>Light theme</h4>
                <div id="theme-fields-light"></div>
                <button type="button" class="btn btn-secondary btn-sm" data-reset-theme="light" style="margin-top:8px;">Reset this theme</button>
            </div>
            <div class="form-group appearance-theme-col">
                <h4>Dark theme</h4>
                <div id="theme-fields-dark"></div>
                <button type="button" class="btn btn-secondary btn-sm" data-reset-theme="dark" style="margin-top:8px;">Reset this theme</button>
            </div>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-appearance-btn">Save appearance</button>
        </div>
    </div>

    <div class="card">
        <h3>Backups</h3>
        <p class="muted">
            Just your own data (accounts, transactions, budgets, rules, schedules, payees, tags) — not
            anyone else's. An admin can also back up the whole site from Admin &gt; Backups.
        </p>

        <h4>Destination</h4>
        <p class="muted">
            A path inside the app container. Leave blank to use the bundled default
            (<code id="backup-default-destination"></code>). To back up to a NAS or other network
            location, it has to be mounted into the container first — ask an admin.
        </p>
        <div class="form-group">
            <label for="backup-destination">Destination path</label>
            <input type="text" id="backup-destination" placeholder="/app/backups">
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-secondary" id="check-destination-btn">Check location</button>
        </div>
        <p class="muted" id="destination-check-status" style="margin-top:12px;"></p>

        <h4 style="margin-top:20px;">Schedule</h4>
        <div class="form-group">
            <label for="backup-frequency">Frequency</label>
            <select id="backup-frequency">
                <option value="disabled">Off — manual only</option>
                <option value="daily">Daily</option>
                <option value="weekly">Weekly</option>
            </select>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="backup-time">Time of day</label>
                <input type="time" id="backup-time">
            </div>
            <div class="form-group" id="backup-day-of-week-group">
                <label for="backup-day-of-week">Day of week</label>
                <select id="backup-day-of-week">
                    <option value="0">Sunday</option>
                    <option value="1">Monday</option>
                    <option value="2">Tuesday</option>
                    <option value="3">Wednesday</option>
                    <option value="4">Thursday</option>
                    <option value="5">Friday</option>
                    <option value="6">Saturday</option>
                </select>
            </div>
        </div>
        <div class="form-group">
            <label for="backup-retention">Keep this many backups</label>
            <input type="number" id="backup-retention" min="1" step="1" style="max-width:120px;">
            <p class="form-hint">Older backups at the destination are deleted automatically once this limit is passed.</p>
        </div>
        <p class="muted">On failure, you'll be emailed (via your own configured mail server above) with the error.</p>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-backup-settings-btn">Save</button>
            <button type="button" class="btn btn-secondary" id="run-backup-btn">Run backup now</button>
        </div>

        <h4 style="margin-top:20px;">Backup files</h4>
        <p class="muted">At <code id="files-destination"></code>.</p>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th>File</th><th>Size</th><th>Created</th><th></th></tr>
                </thead>
                <tbody id="files-tbody"></tbody>
            </table>
        </div>

        <h4 style="margin-top:20px;">Restore from an uploaded file</h4>
        <p class="muted">This replaces your data with the contents of the backup — it can't be undone.</p>
        <div class="form-group">
            <input type="file" id="restore-upload-input" accept=".gz">
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-danger" id="restore-upload-btn">Restore from upload</button>
        </div>

        <h4 style="margin-top:20px;">Recent runs</h4>
        <div class="table-wrap">
            <table class="data-table">
                <thead>
                    <tr><th>When</th><th>Action</th><th>Trigger</th><th>Status</th><th>Detail</th></tr>
                </thead>
                <tbody id="runs-tbody"></tbody>
            </table>
        </div>
    </div>
</main>
<%- include('../components/footer', { pageScripts: ['/js/account.js', '/js/backupPanel.js', '/js/accountBackups.js'] }) %>
