<%- include('../components/head', { title: title }) %>
<%- include('../components/nav') %>
<main class="page page-admin-oidc">
    <div class="page-header">
        <h1>OIDC / SSO</h1>
    </div>
    <div id="oidc-error" class="form-error" hidden></div>
    <div id="oidc-success" class="form-success" hidden></div>
    <p class="muted">
        Works with any self-hosted identity provider that publishes standard OIDC discovery
        (Authentik, Keycloak, Authelia, etc). Register this app there first — the redirect URI
        it needs is <code id="oidc-redirect-uri"></code>. When enabled, the login page offers
        SSO alongside local and LDAP accounts. A first-time login auto-creates an account here.
    </p>

    <div class="card">
        <div class="checkbox-row form-group">
            <input type="checkbox" id="oidc-enabled">
            <label for="oidc-enabled">Enable OIDC login</label>
        </div>
        <div class="form-group">
            <label for="oidc-issuer-url">Issuer URL</label>
            <input type="text" id="oidc-issuer-url" placeholder="https://auth.example.lan/application/o/balancedwaypoints/">
            <p class="form-hint">The base URL your IdP serves its <code>/.well-known/openid-configuration</code> document from.</p>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label for="oidc-client-id">Client ID</label>
                <input type="text" id="oidc-client-id">
            </div>
            <div class="form-group">
                <label for="oidc-client-secret">Client secret</label>
                <input type="password" id="oidc-client-secret" autocomplete="off">
                <p class="form-hint" id="oidc-client-secret-hint" hidden>Leave blank to keep the currently saved secret.</p>
            </div>
        </div>
        <div class="form-group">
            <label for="oidc-scopes">Scopes</label>
            <input type="text" id="oidc-scopes" placeholder="openid profile email">
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-oidc-btn">Save</button>
            <button type="button" class="btn btn-danger" id="reset-oidc-btn">Disable &amp; clear</button>
        </div>
    </div>
</main>
<%- include('../components/footer', { pageScripts: ['/js/adminOidc.js'] }) %>
