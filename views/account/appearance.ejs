<%- include('../components/head', { title: title }) %>
<%- include('../components/nav') %>
<main class="page page-account-appearance">
    <div class="page-header">
        <h1>Appearance</h1>
    </div>
    <div id="account-error" class="form-error" hidden></div>
    <div id="account-success" class="form-success" hidden></div>

    <div class="card">
        <p class="muted">Override any color the app uses, independently for light and dark theme. Leave a
        field at its default (or hit "Reset this theme") to keep following the app's normal palette there.</p>
        <div class="form-row">
            <div class="form-group appearance-theme-col">
                <h4>Light theme</h4>
                <div id="theme-fields-light"></div>
                <button type="button" class="btn btn-secondary btn-sm" data-reset-theme="light" style="margin-top:8px;">Reset this theme</button>
            </div>
            <div class="form-group appearance-theme-col">
                <h4>Dark theme</h4>
                <div id="theme-fields-dark"></div>
                <button type="button" class="btn btn-secondary btn-sm" data-reset-theme="dark" style="margin-top:8px;">Reset this theme</button>
            </div>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-appearance-btn">Save appearance</button>
        </div>
    </div>

    <div class="card">
        <h3>Register badges</h3>
        <p class="muted">Pick a color for the "Scheduled", "Due", and "Autopay" badges shown on the register and
        Schedules page, so each is easier to tell apart at a glance. Leave a field at its default (or hit
        "Reset badge colors") to keep the app's normal look.</p>
        <div class="form-row">
            <div class="form-group">
                <label for="badge-color-scheduled">Scheduled</label>
                <input type="color" id="badge-color-scheduled">
            </div>
            <div class="form-group">
                <label for="badge-color-due">Due</label>
                <input type="color" id="badge-color-due">
            </div>
            <div class="form-group">
                <label for="badge-color-autopay">Autopay</label>
                <input type="color" id="badge-color-autopay">
            </div>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-badge-colors-btn">Save badge colors</button>
            <button type="button" class="btn btn-secondary" id="reset-badge-colors-btn">Reset badge colors</button>
        </div>
    </div>
</main>
<%- include('../components/footer', { pageScripts: ['/js/accountAppearance.js'] }) %>
