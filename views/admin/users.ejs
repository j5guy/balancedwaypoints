<%- include('../components/head', { title: title }) %>
<%- include('../components/nav') %>
<main class="page page-admin-users">
    <div class="page-header">
        <h1>Users</h1>
    </div>
    <div id="users-error" class="form-error" hidden></div>
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr><th>Email</th><th>Name</th><th>Admin</th><th>Last login</th><th></th></tr>
            </thead>
            <tbody id="users-tbody"></tbody>
        </table>
    </div>
</main>

<div class="modal-overlay" id="edit-user-overlay" hidden>
    <div class="modal-card">
        <h3>Edit user</h3>
        <p class="form-error" id="edit-user-error" hidden></p>
        <div class="form-group">
            <label for="edit-user-email">Email</label>
            <input type="email" id="edit-user-email">
        </div>
        <div class="form-group">
            <label for="edit-user-display-name">Display name</label>
            <input type="text" id="edit-user-display-name">
        </div>
        <p class="form-hint" id="edit-user-ldap-hint" hidden>This is an LDAP account — logging in again with a
        real <code>mail</code>/name set in the directory will overwrite whatever's saved here.</p>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-edit-user-btn">Save</button>
            <button type="button" class="btn btn-secondary" id="cancel-edit-user-btn">Cancel</button>
        </div>

        <div id="edit-user-password-section">
            <hr>
            <h3>Reset password</h3>
            <p class="form-error" id="edit-user-password-error" hidden></p>
            <div class="form-group">
                <label for="edit-user-password">New password</label>
                <input type="password" id="edit-user-password" minlength="8" autocomplete="new-password">
            </div>
            <div class="form-group">
                <label for="edit-user-password-confirm">Confirm new password</label>
                <input type="password" id="edit-user-password-confirm" minlength="8" autocomplete="new-password">
            </div>
            <p class="form-hint">Sets this account's password directly — they aren't notified, and nothing here requires knowing the old one.</p>
            <div class="btn-row">
                <button type="button" class="btn btn-danger" id="reset-password-btn">Set Password</button>
            </div>
        </div>
    </div>
</div>
<%- include('../components/footer', { pageScripts: ['/js/admin.js'] }) %>
