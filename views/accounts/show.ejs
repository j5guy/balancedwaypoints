<%- include('../components/head', { title: title }) %>
<%- include('../components/nav') %>
<main class="page page-register" data-account-id="<%= accountId %>">
    <div class="page-header">
        <h1 id="account-name">Register</h1>
        <div class="stat-card" style="padding:10px 18px;">
            <div class="stat-label">Balance</div>
            <div class="stat-value money" id="account-balance">—</div>
        </div>
    </div>
    <div id="register-error" class="form-error" hidden></div>

    <p class="muted" style="font-size:0.85rem;">
        Type a new transaction directly into the top row of the table below.
        Need a transfer or a split across categories instead?
        <a href="#" id="toggle-advanced-form-link">Use the full form</a>.
    </p>

    <div class="card" id="txn-form-card" hidden>
        <h3 id="txn-form-title">New transaction</h3>
        <input type="hidden" id="txn-id">
        <div class="form-row">
            <div class="form-group">
                <label for="txn-date">Date</label>
                <input type="date" id="txn-date">
            </div>
            <div class="form-group">
                <label for="txn-payee">Payee</label>
                <input type="text" id="txn-payee" list="payee-options" placeholder="Payee name">
                <datalist id="payee-options"></datalist>
            </div>
            <div class="form-group">
                <label for="txn-amount">Amount</label>
                <input type="number" id="txn-amount" step="0.01" placeholder="-45.00">
                <p class="form-hint">Negative for money out, positive for money in.</p>
            </div>
        </div>

        <div class="checkbox-row form-group">
            <input type="checkbox" id="txn-is-transfer">
            <label for="txn-is-transfer">This is a transfer to another account</label>
        </div>

        <div class="form-row" id="txn-category-group">
            <div class="form-group">
                <label for="txn-category">Category</label>
                <input type="text" id="txn-category" list="category-options" placeholder="Category name">
                <datalist id="category-options"></datalist>
            </div>
            <div class="form-group">
                <label for="txn-category-new-group">Group (for a new category)</label>
                <select id="txn-category-new-group"><option value="">— pick a group —</option></select>
                <p class="form-hint">Only used if "Category" above doesn't match an existing one — it'll be created in this group.</p>
            </div>
        </div>

        <div class="form-group" id="txn-transfer-group" hidden>
            <label for="txn-transfer-account">Transfer to</label>
            <select id="txn-transfer-account"></select>
        </div>

        <div class="form-group">
            <div class="btn-row">
                <button type="button" class="btn btn-secondary btn-sm" id="toggle-splits-btn">Split into categories</button>
                <button type="button" class="btn btn-secondary btn-sm" id="suggest-rules-btn">Suggest from rules</button>
            </div>
        </div>

        <div id="splits-editor" hidden>
            <div id="splits-list"></div>
            <button type="button" class="btn btn-secondary btn-sm" id="add-split-btn">Add split line</button>
            <p class="form-hint">Split amounts must add up to the total amount above.</p>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label for="txn-tags">Tags</label>
                <input type="text" id="txn-tags" placeholder="comma, separated, tags">
            </div>
            <div class="form-group">
                <label for="txn-notes">Notes</label>
                <input type="text" id="txn-notes">
            </div>
            <div class="form-group checkbox-row" style="align-self:flex-end;">
                <input type="checkbox" id="txn-cleared">
                <label for="txn-cleared">Cleared</label>
            </div>
        </div>

        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-txn-btn">Save transaction</button>
            <button type="button" class="btn btn-secondary" id="cancel-txn-btn" hidden>Cancel edit</button>
        </div>
    </div>

    <p class="muted" id="register-hint" style="font-size:0.85rem;" hidden>Drag a row by its handle (⠿) to reorder the register — the Balance column recalculates from the new order, top to bottom.</p>
    <div class="table-wrap">
        <table class="data-table register-table">
            <colgroup>
                <col style="width:22px">
                <col style="width:92px">
                <col style="width:130px">
                <col style="width:120px">
                <col>
                <col style="width:100px">
                <col style="width:88px">
                <col style="width:88px">
                <col style="width:56px">
                <col style="width:34px">
            </colgroup>
            <thead>
                <tr><th></th><th>Date</th><th>Payee</th><th>Category</th><th class="wrap">Notes</th><th>Tags</th><th>Amount</th><th>Balance</th><th></th><th title="Cleared">✓</th></tr>
            </thead>
            <tbody id="quick-add-tbody">
                <tr class="quick-add-row">
                    <td class="muted" style="text-align:center;">+</td>
                    <td><input type="date" id="qa-date"></td>
                    <td><input type="text" id="qa-payee" list="payee-options" placeholder="Payee"></td>
                    <td>
                        <div style="display:flex;flex-direction:column;gap:3px;">
                            <input type="text" id="qa-category" list="category-options" placeholder="Category">
                            <select id="qa-category-new-group" title="Group for a new category" style="font-size:0.78rem;padding:2px 4px;">
                                <option value="">new category's group…</option>
                            </select>
                        </div>
                    </td>
                    <td><input type="text" id="qa-notes" placeholder="Notes"></td>
                    <td><input type="text" id="qa-tags" placeholder="tag, tag"></td>
                    <td><input type="number" id="qa-amount" step="0.01" placeholder="-45.00"></td>
                    <td class="muted">—</td>
                    <td><button type="button" class="btn btn-primary btn-sm" id="qa-add-btn">Add</button></td>
                    <td style="text-align:center;"><input type="checkbox" id="qa-cleared" title="Cleared"></td>
                </tr>
            </tbody>
            <tbody id="register-tbody"></tbody>
        </table>
    </div>
</main>
<%- include('../components/footer', { pageScripts: ['/js/dragReorder.js', '/js/register.js'] }) %>
