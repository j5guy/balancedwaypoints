<%- include('../components/head', { title: title }) %>
<%- include('../components/nav') %>
<main class="page page-account">
    <div class="page-header">
        <h1>My Account</h1>
    </div>
    <p><span id="account-email" class="money"></span> <span class="badge" id="account-auth-source"></span></p>

    <div class="admin-tiles">
        <a href="/account/general" class="admin-tile">
            <h3>General</h3>
            <p>Choose what page you land on when you log in.</p>
        </a>
        <a href="/account/notifications" class="admin-tile">
            <h3>Email notifications</h3>
            <p>Schedule alerts and the opt-in weekly summary.</p>
        </a>
        <a href="/account/mail-server" class="admin-tile">
            <h3>My outgoing mail server</h3>
            <p>Set up your own SMTP server so notifications actually go out.</p>
        </a>
        <a href="/account/api-access" class="admin-tile">
            <h3>API access</h3>
            <p>A read-only key for external tools like Grafana.</p>
        </a>
        <a href="/account/appearance" class="admin-tile">
            <h3>Appearance</h3>
            <p>Override any color the app uses, for light and dark theme.</p>
        </a>
        <a href="/account/backups" class="admin-tile">
            <h3>Backups</h3>
            <p>Back up just your own data, manually or on a schedule.</p>
        </a>
        <a href="/account/bank-sync" class="admin-tile">
            <h3>Bank Sync</h3>
            <p>Connect SimpleFIN to import new transactions automatically.</p>
        </a>
    </div>
</main>
<%- include('../components/footer', { pageScripts: ['/js/accountIndex.js'] }) %>
