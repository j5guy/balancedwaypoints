<%- include('../components/head', { title: title }) %>
<%- include('../components/nav') %>
<main class="page page-payees">
    <div class="page-header">
        <h1>Payees</h1>
        <button type="button" class="btn btn-primary" id="new-payee-btn">Add payee</button>
    </div>
    <div id="payees-error" class="form-error" hidden></div>

    <div class="card" id="new-payee-form" hidden>
        <div class="form-row">
            <div class="form-group">
                <label for="payee-name">Name</label>
                <input type="text" id="payee-name">
            </div>
            <div class="form-group">
                <label for="payee-default-category">Default category</label>
                <select id="payee-default-category"><option value="">— none —</option></select>
            </div>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-payee-btn">Save</button>
            <button type="button" class="btn btn-secondary" id="cancel-payee-btn">Cancel</button>
        </div>
    </div>

    <div class="table-wrap">
        <table class="data-table">
            <thead><tr><th>Name</th><th>Default category</th><th></th></tr></thead>
            <tbody id="payees-tbody"></tbody>
        </table>
    </div>
</main>
<%- include('../components/footer', { pageScripts: ['/js/payees.js'] }) %>
