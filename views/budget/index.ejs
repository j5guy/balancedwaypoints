<%- include('../components/head', { title: title }) %>
<%- include('../components/nav') %>
<main class="page page-budget">
    <%- include('../components/ownerSwitcher') %>
    <div class="page-header">
        <h1>Budget</h1>
        <button type="button" class="btn btn-secondary btn-sm" id="new-group-btn">Add category group</button>
    </div>
    <div id="budget-error" class="form-error" hidden></div>

    <div class="month-nav">
        <button type="button" class="btn btn-secondary btn-sm" id="prev-month-btn">&larr;</button>
        <div class="month-label" id="month-label"></div>
        <button type="button" class="btn btn-secondary btn-sm" id="next-month-btn">&rarr;</button>
        <button type="button" class="btn btn-secondary btn-sm" id="toggle-copy-budget-btn" style="margin-left:12px;">Copy budget from…</button>
    </div>

    <div class="card" id="copy-budget-form" hidden>
        <div class="form-row">
            <div class="form-group">
                <label for="copy-budget-source">Copy assigned amounts from</label>
                <input type="month" id="copy-budget-source">
                <p class="form-hint">Replaces this month's assigned amount for every category that has one in the source month. Categories not assigned anything there are left as-is here.</p>
            </div>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="copy-budget-confirm-btn">Copy</button>
            <button type="button" class="btn btn-secondary" id="copy-budget-cancel-btn">Cancel</button>
        </div>
    </div>

    <div class="rta-banner" id="rta-banner">
        <div>
            <div class="rta-label">Ready to Assign</div>
            <div class="rta-value" id="rta-value">$0.00</div>
        </div>
    </div>

    <div class="card" id="new-group-form" hidden>
        <div class="form-row">
            <div class="form-group">
                <label for="group-name">Group name</label>
                <input type="text" id="group-name">
            </div>
            <div class="form-group checkbox-row" style="align-self:flex-end;">
                <input type="checkbox" id="group-is-income">
                <label for="group-is-income">Income group (excluded from budgeting)</label>
            </div>
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-primary" id="save-group-btn">Save</button>
            <button type="button" class="btn btn-secondary" id="cancel-group-btn">Cancel</button>
        </div>
    </div>

    <p class="muted" style="font-size:0.85rem;" id="budget-management-hint" hidden>
        You're managing this person's Categories and Category Groups — dollar assignment (Ready to Assign, monthly
        budgeting) stays theirs alone, so only the category structure is shown here.
    </p>
    <p class="muted" style="font-size:0.85rem;" id="budget-drag-hint">Drag a category or group by its handle (⠿) to reorder.</p>
    <div class="budget-row-head">
        <span>Category</span><span>Assigned</span><span>Activity</span><span>Available</span>
    </div>
    <div id="budget-groups"></div>

    <div id="income-section" hidden>
        <h3 style="margin-top:32px;">Income</h3>
        <p class="muted" style="font-size:0.85rem;">
            Income categories aren't budgeted against — money you receive already counts toward Ready to
            Assign the moment it posts to an on-budget account, so there's nothing to assign here. This is
            just where they're listed and managed.
        </p>
        <div id="income-groups"></div>
    </div>
</main>

<div class="modal-overlay" id="delete-category-overlay" hidden>
    <div class="modal-card">
        <h3>Delete category</h3>
        <p id="delete-category-warning" class="form-error"></p>
        <p>This <strong>cannot be undone</strong>. Any transactions currently using this category will be
        moved first:</p>
        <div class="form-group">
            <label for="delete-category-reassign">Move existing transactions to</label>
            <select id="delete-category-reassign"><option value="">— no category —</option></select>
        </div>
        <p>To confirm, type the category's name below:</p>
        <p class="muted" id="delete-category-name-hint" style="font-weight:600;"></p>
        <div class="form-group">
            <input type="text" id="delete-category-confirm-input" autocomplete="off">
        </div>
        <div class="btn-row">
            <button type="button" class="btn btn-danger" id="delete-category-confirm-btn" disabled>Delete category</button>
            <button type="button" class="btn btn-secondary" id="delete-category-cancel-btn">Cancel</button>
        </div>
    </div>
</div>
<%- include('../components/footer', { pageScripts: ['/js/dragReorder.js', '/js/ownerSwitcher.js', '/js/budget.js'] }) %>
